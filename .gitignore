# Virtual environments
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Model weights and caches (VGG19 downloads to the torch cache)
models/*
!models/.gitkeep
*.pth
*.pt
*.ckpt

# Data: keep folders, ignore images by default (add only ones you may share)
data/content/*
data/style/*
!data/content/.gitkeep
!data/style/.gitkeep

# Outputs: keep results (used in README), ignore scratch files
outputs/tmp/
outputs/*.tmp

# Streamlit
.streamlit/secrets.toml

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Logs
*.log
